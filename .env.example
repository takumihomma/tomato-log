# Cloudflare Pages / Wrangler CLI デプロイ環境変数設定例
# このファイルを .env にコピーし、実際の値を入力してください（.env は Git 管理外です）

# Cloudflare Pages / Wrangler CLI デプロイ環境変数設定例
# 概要： https://note.com/paru877/n/nbc737b05db3d
# 1. https://www.cloudflare.com/ja-jp/developer-platform/products/pages/　にアクセス、サインアップ
# 2. ship something new - Create app
# 3. Connect Github - Only select repositories - Install & Authorize - Save
# GitHub 連携で自動デプロイしている場合, Pushするだけで、Cloudflare Pages が自動で再デプロイを開始します。


# Cloudflare アカウント ID (ダッシュボード右側または Overview ページから取得)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare API トークン (Cloudflare Pages 読み書き権限を持つ API トークン)
# 取得元: Dash -> My Profile -> API Tokens -> Create Token ("Cloudflare Pages" テンプレート等)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Pages プロジェクト名
CLOUDFLARE_PROJECT_NAME=tomato-log

# (オプション) レガシー Global API Key 認証を使用する場合
# CLOUDFLARE_EMAIL=your_email@example.com
# CLOUDFLARE_API_KEY=your_global_api_key_here
